# ==============================================================================
# KrishiVaani Deployment Environment Variables (.env.example)
# Target: Vercel (Frontend), Render (Backend), Supabase (PostgreSQL Database)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND & DATABASE CONFIGURATION (Render Free Web Service)
# ------------------------------------------------------------------------------
# Port for the backend server (Render automatically sets PORT at runtime)
PORT=3000

# Node Environment ('production' or 'development')
NODE_ENV=production

# Supabase Free PostgreSQL Connection String
# Example: postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Leave unset or empty for local SQLite (krishivaani.db) development
DATABASE_URL=postgresql://postgres:your_supabase_password@db.your_project.supabase.co:5432/postgres

# Secret key for signing JWT authentication tokens
JWT_SECRET=your_long_random_jwt_secret_key_change_in_production_2026

# Allowed Frontend Origin(s) for CORS (Comma-separated for multiple URLs)
# Example: https://krishivaani.vercel.app,http://localhost:5173
FRONTEND_URL=https://your-krishivaani-app.vercel.app

# ------------------------------------------------------------------------------
# 2. FRONTEND CONFIGURATION (Vercel Hobby Deployment)
# ------------------------------------------------------------------------------
# URL pointing to the deployed Render backend API service
# Example: https://krishivaani-backend.onrender.com
# Leave empty for local development (defaults to relative /api)
VITE_API_BASE_URL=https://your-krishivaani-backend.onrender.com

# ------------------------------------------------------------------------------
# 3. OPTIONAL THIRD-PARTY INTEGRATIONS (Free Fallbacks Included)
# ------------------------------------------------------------------------------
# Google Gemini API key (Optional for enhanced voice parsing; Web Speech API works without it)
GEMINI_API_KEY=

# Google Maps API key (Optional; full offline 36 Maharashtra districts & GPS fallback included)
VITE_GOOGLE_MAPS_API_KEY=
